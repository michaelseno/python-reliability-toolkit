#!/usr/bin/env python3
from __future__ import annotations

import json
import site
import sys
from pathlib import Path
from urllib.parse import unquote, urlparse


def _site_package_dirs() -> list[Path]:
    candidates: list[str] = []
    try:
        candidates.extend(site.getsitepackages())
    except AttributeError:
        pass
    try:
        candidates.append(site.getusersitepackages())
    except AttributeError:
        pass
    return [Path(candidate) for candidate in candidates if candidate]


def _add_editable_project_path() -> None:
    for site_packages in _site_package_dirs():
        for dist_info in site_packages.glob("reliabilitykit-*.dist-info"):
            direct_url_path = dist_info / "direct_url.json"
            if not direct_url_path.exists():
                continue
            try:
                direct_url = json.loads(direct_url_path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            if not direct_url.get("dir_info", {}).get("editable"):
                continue
            parsed_url = urlparse(str(direct_url.get("url", "")))
            if parsed_url.scheme != "file":
                continue
            project_path = Path(unquote(parsed_url.path))
            if project_path.exists():
                sys.path.insert(0, str(project_path))
                return


try:
    from reliabilitykit.cli.main import app
except ModuleNotFoundError as exc:
    if exc.name != "reliabilitykit":
        raise
    _add_editable_project_path()
    from reliabilitykit.cli.main import app


if __name__ == "__main__":
    sys.exit(app())
